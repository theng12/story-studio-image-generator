{
  "manifest_version": 3,
  "name": "Story Studio Bulk Asset",
  "version": "0.6.2",
  "description": "Generate Story Studio KH scene images & video on Google Flow (and images on Grok Imagine) from your scene plan, using your web-subscription credits, and save each asset with the correct name.",
  "permissions": ["downloads", "storage", "scripting", "tabs", "sidePanel", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://flow-content.google/*",
    "https://grok.com/*",
    "https://*.grok.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Story Studio Bulk Asset (click to open side panel)"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/*"],
      "js": ["src/content/flow-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://labs.google/fx/*"],
      "js": ["src/content/flow.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["src/content/grok-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["src/content/grok.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
