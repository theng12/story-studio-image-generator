{
  "manifest_version": 3,
  "name": "Story Studio Bulk Asset",
  "version": "0.18.1",
  "description": "Generate Story Studio KH scene images and video through Google Flow, Google AI Studio, Grok, Perchance, FreeGen, Leonardo, and Pollinations, then save each asset with the correct name.",
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "tabs",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://labs.google/*",
    "https://aistudio.google.com/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://flow-content.google/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://perchance.org/*",
    "https://*.perchance.org/*",
    "https://freegen.app/*",
    "https://*.freegen.app/*",
    "https://app.leonardo.ai/*",
    "https://*.leonardo.ai/*",
    "https://image.pollinations.ai/*",
    "https://*.pollinations.ai/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Story Studio Bulk Asset (click to open side panel)"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*"
      ],
      "js": [
        "src/content/flow-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/*"
      ],
      "js": [
        "src/content/flow.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "src/content/aistudio-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "src/content/aistudio.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/content/grok-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/content/grok.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.leonardo.ai/*"
      ],
      "js": [
        "src/content/leonardo-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.leonardo.ai/*"
      ],
      "js": [
        "src/content/leonardo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://freegen.app/*"
      ],
      "js": [
        "src/content/freegen-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://freegen.app/*"
      ],
      "js": [
        "src/content/freegen.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.perchance.org/ai-text-to-image-generator*",
        "https://image-generation.perchance.org/embed*"
      ],
      "js": [
        "src/content/perchance-main.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.perchance.org/ai-text-to-image-generator*"
      ],
      "js": [
        "src/content/perchance.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
