{
  "manifest_version": 3,
  "name": "Story Studio Image Generator",
  "version": "0.50.34",
  "description": "Generate images from prompts with a signed-in provider, or work as a Gateway Studio image worker.",
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "tabs",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://aistudio.google.com/*",
    "https://chat.qwen.ai/*",
    "https://cdn.qwenlm.ai/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://flow-content.google/*",
    "https://app.leonardo.ai/*",
    "https://*.leonardo.ai/*",
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Story Studio Image Generator (click to open side panel)"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "src/content/aistudio-main.js",
        "src/content/aistudio.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "src/content/qwen-main.js",
        "src/content/qwen.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.leonardo.ai/*"
      ],
      "js": [
        "src/content/leonardo-main.js",
        "src/content/leonardo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/chatgpt-main.js",
        "src/content/chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "src/flow-recorder.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "key": ""
}
