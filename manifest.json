{
  "manifest_version": 3,
  "name": "Story Studio Image Generator for Story Studio",
  "version": "0.1.0",
  "description": "Generate scene images (and video) on Google Flow from your Story Studio KH scene plan, using your Google AI subscription credits, and save each asset with the correct name.",
  "permissions": ["downloads", "storage", "scripting", "tabs", "sidePanel", "alarms"],
  "host_permissions": [
    "http://localhost:8766/*",
    "http://127.0.0.1:8766/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Story Studio Image Generator for Story Studio (click to open side panel)"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/*"],
      "js": ["src/content/flow-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://labs.google/fx/*"],
      "js": ["src/content/flow.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "src/icons/icon128.png"
  }
}
